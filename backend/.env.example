# ==============================================================================
# RO Water Purifier Service Management - Environment Configuration Template
# Copy this file to .env and supply appropriate values.
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Application host and port (used when running uvicorn)
APP_HOST=127.0.0.1
APP_PORT=8000

# Environment mode: 'development' or 'production' (affects secure cookie flag)
ENVIRONMENT=development

# Single-business admin username
AUTH_USERNAME=admin

# Secure password hash (BCrypt hash of admin password)
# Generate via: python -c "import bcrypt; print(bcrypt.hashpw(b'<password>', bcrypt.gensalt()).decode())"
AUTH_PASSWORD_HASH=replace_with_secure_hash

# Random secret key used for HMAC session token signing (minimum 32 characters)
SECRET_KEY=replace_with_long_random_secret

# Session duration in seconds (default 86400 = 24 hours)
SESSION_MAX_AGE_SECONDS=86400

# Comma-separated allowed CORS origins for the frontend
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
